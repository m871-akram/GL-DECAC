# Do not version generated files.
/target
*.class
*.ass

# ANTLR generated sources
src/main/antlr4/**/gen/

# These are IDE-specific files. We version pom.xml, and rely on IDE
# integration with maven (or with maven's generation of IDE files like
# mvn eclipse:eclipse).
.classpath
.project
.metadata
.settings
.idea/
*.iml
out/

# OS metadata
.DS_Store

# Provided IMA tooling/resources (nested repo, binaries, archives).
global/

# Course material (teachers' slides) — local only, not for the public repo
Projet GL/
