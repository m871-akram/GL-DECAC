// Description:
//     lecture d'entiers et de flottants
//
// Resultats:
//    (Entrer 10)
//    Vous avez entré : 10
//    (Entrer 3.14)
//    Vous avez entré : 3.14000e+00
//
// Historique:
//    cree le 15/01/2026

{
    int x;
    float y;

    println("Entrez un entier :");
    x = readInt();
    println("Vous avez entré : ", x);

    println("Entrez un flottant :");
    y = readFloat();
    println("Vous avez entré : ", y);
}