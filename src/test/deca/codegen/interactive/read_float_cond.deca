// Description:
//    Read dans une condition
//
// Resultats :
//    Affiche si le nombre lu est positif ou non
//
// Historique:
//    cree le 18/01/2026

{
    float x;
    println("Entrez un nombre réel :");
    x = readFloat();

    if (x > 0.0) {
        println("Le nombre est positif : ", x);
    } else {
        println("Le nombre n'est pas positif : ", x);
    }
}
