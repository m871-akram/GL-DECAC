// Description:
//    Verifie l'ordre : si X.m(Y1, Y2, ... Yn) 
//     alors évalue X, puis Y1, puis Y2...
//
// Resultats:
//    Objet
//    P1
//    P2
//
// Historique:
//    cree le 17/01/2026

class Track {
    Track objet() { println("Objet"); return this; }
    int p(string s) { println(s); return 0; }
    void m(int a, int b) {}
}

{
    Track t = new Track();
    t.objet().m(t.p("P1"), t.p("P2"));
}

