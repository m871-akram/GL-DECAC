; start main program
; Construction des tables des methodes
; --------------------------------------------------
; Classe Lambda
; --------------------------------------------------
; Table des méthodes de Lambda à l'adresse 1(GB)
	LOAD #0, R0
	STORE R0, 1(GB)
; ===== Sous-programmes d'initialisation =====
init.Lambda:
; Initialisation des champs de Lambda
	PUSH R1
	LOAD -2(LB), R1
	LOAD -2(LB), R1
	LOAD #10, R2
	STORE R2, 0(R1)
	POP R1
	RTS
; ===== Code des méthodes =====
; --------------------------------------------------
; Méthodes de la classe Lambda
; --------------------------------------------------
; Main program
; Beginning of main declarations:
	NEW #1, R2
	BOV heap_full_isr
	LEA 1(GB), R0
	STORE R0, 0(R2)
	PEA 0(R2)
	BSR init.Lambda
	SUBSP #1
	STORE R2, 1(LB)
	NEW #1, R2
	BOV heap_full_isr
	LEA 1(GB), R0
	STORE R0, 0(R2)
	PEA 0(R2)
	BSR init.Lambda
	SUBSP #1
	STORE R2, 2(LB)
	TSTO #2
	BOV stack_overflow_isr
	ADDSP #2
; Beginning of main instructions:
	LOAD 1(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	ADDSP #2
	STORE R2, 0(SP)
	LOAD 2(LB), R2
	STORE R2, -1(SP)
	LOAD 0(SP), R2
	LOAD 0(R2), R2
	LOAD 0(R2), R2
	BSR R2
	SUBSP #2
	LOAD R0, R2
	CMP #0, R2
	BEQ else_0
	WSTR "true"
	WNL
	BRA end_if_1
else_0:
	WSTR "false"
	WNL
end_if_1:
	HALT
; --- Interrupt Service Routines (ISR) ---
heap_full_isr:
	WSTR "Erreur : Tas plein"
	WNL
	ERROR
stack_overflow_isr:
	WSTR "Erreur : Pile pleine"
	WNL
	ERROR
null_ptr_isr:
	WSTR "Erreur : Dereferencement null"
	WNL
	ERROR
; end main program
