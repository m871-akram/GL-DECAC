; start main program
; Construction des tables des methodes
; --------------------------------------------------
; Classe Test
; --------------------------------------------------
; Table des méthodes de Test à l'adresse 1(GB)
	LOAD #0, R0
	STORE R0, 1(GB)
	LOAD code.Test.modifier, R0
	STORE R0, 2(GB)
; ===== Sous-programmes d'initialisation =====
init.Test:
; Initialisation des champs de Test
	PUSH R1
	LOAD -2(LB), R1
	POP R1
	RTS
; ===== Code des méthodes =====
; --------------------------------------------------
; Méthodes de la classe Test
; --------------------------------------------------
code.Test.modifier:
; Méthode modifier
	TSTO #0
	BOV stack_overflow_isr
	ADDSP #0
	LOAD #10, R2
	STORE R2, -3(LB)
	RTS
; Main program
; Beginning of main declarations:
	NEW #1, R2
	BOV heap_full_isr
	LEA 1(GB), R0
	STORE R0, 0(R2)
	PUSH R2
	BSR init.Test
	SUBSP #1
	STORE R2, 1(LB)
	LOAD #5, R2
	STORE R2, 2(LB)
	TSTO #2
	BOV stack_overflow_isr
	ADDSP #2
; Beginning of main instructions:
	LOAD 1(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	ADDSP #2
	STORE R2, 0(SP)
	LOAD 2(LB), R2
	STORE R2, -1(SP)
	LOAD 0(SP), R2
	LOAD 0(R2), R2
	LOAD 1(R2), R2
	BSR R2
	SUBSP #2
	LOAD 2(LB), R1
	WINT
	WNL
	HALT
; --- Interrupt Service Routines (ISR) ---
heap_full_isr:
	WSTR "Erreur : Tas plein"
	WNL
	ERROR
stack_overflow_isr:
	WSTR "Erreur : Pile pleine"
	WNL
	ERROR
null_ptr_isr:
	WSTR "Erreur : Dereferencement null"
	WNL
	ERROR
; end main program
