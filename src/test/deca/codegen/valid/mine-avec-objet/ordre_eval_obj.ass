; start main program
; Construction des tables des methodes
; --------------------------------------------------
; Classe Track
; --------------------------------------------------
; Table des méthodes de Track à l'adresse 1(GB)
	LOAD #0, R0
	STORE R0, 1(GB)
	LOAD code.Track.objet, R0
	STORE R0, 2(GB)
	LOAD code.Track.p, R0
	STORE R0, 3(GB)
	LOAD code.Track.m, R0
	STORE R0, 4(GB)
; ===== Sous-programmes d'initialisation =====
init.Track:
; Initialisation des champs de Track
	PUSH R1
	LOAD -2(LB), R1
	POP R1
	RTS
; ===== Code des méthodes =====
; --------------------------------------------------
; Méthodes de la classe Track
; --------------------------------------------------
code.Track.objet:
; Méthode objet
	TSTO #0
	BOV stack_overflow_isr
	ADDSP #0
	WSTR "Objet"
	WNL
	LOAD -2(LB), R0
	RTS
	RTS
code.Track.p:
; Méthode p
	TSTO #0
	BOV stack_overflow_isr
	ADDSP #0
	LOAD -3(LB), R1
	WINT
	WNL
	LOAD #0, R0
	RTS
	RTS
code.Track.m:
; Méthode m
	TSTO #0
	BOV stack_overflow_isr
	ADDSP #0
	RTS
; Main program
; Beginning of main declarations:
	NEW #1, R2
	BOV heap_full_isr
	LEA 1(GB), R0
	STORE R0, 0(R2)
	PEA 0(R2)
	BSR init.Track
	SUBSP #1
	STORE R2, 1(LB)
	TSTO #1
	BOV stack_overflow_isr
	ADDSP #1
; Beginning of main instructions:
	LOAD 1(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	ADDSP #1
	STORE R2, 0(SP)
	LOAD 0(SP), R2
	LOAD 0(R2), R2
	LOAD 1(R2), R2
	BSR R2
	SUBSP #1
	LOAD R0, R2
	CMP #null, R2
	BOV null_ptr_isr
	ADDSP #3
	STORE R2, 0(SP)
	LOAD 1(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	ADDSP #2
	STORE R2, 0(SP)
	LOAD #0, R2
	STORE R2, -1(SP)
	LOAD 0(SP), R2
	LOAD 0(R2), R2
	LOAD 2(R2), R2
	BSR R2
	SUBSP #2
	LOAD R0, R2
	STORE R2, -1(SP)
	LOAD 1(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	ADDSP #2
	STORE R2, 0(SP)
	LOAD #1, R2
	STORE R2, -1(SP)
	LOAD 0(SP), R2
	LOAD 0(R2), R2
	LOAD 2(R2), R2
	BSR R2
	SUBSP #2
	LOAD R0, R2
	STORE R2, -2(SP)
	LOAD 0(SP), R2
	LOAD 0(R2), R2
	LOAD 3(R2), R2
	BSR R2
	SUBSP #3
	HALT
; --- Interrupt Service Routines (ISR) ---
null_ptr_isr:
	WSTR "Erreur : Dereferencement null"
	WNL
	ERROR
heap_full_isr:
	WSTR "Erreur : Tas plein"
	WNL
	ERROR
stack_overflow_isr:
	WSTR "Erreur : Pile pleine"
	WNL
	ERROR
; end main program
