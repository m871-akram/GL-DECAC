; start main program
; Construction des tables des methodes
; --------------------------------------------------
; Classe Default
; --------------------------------------------------
; Table des méthodes de Default à l'adresse 1(GB)
	LOAD #0, R0
	STORE R0, 1(GB)
; ===== Sous-programmes d'initialisation =====
init.Default:
; Initialisation des champs de Default
	PUSH R1
	LOAD -2(LB), R1
	LOAD -2(LB), R1
	LOAD -2(LB), R1
	LOAD -2(LB), R1
	LOAD -2(LB), R1
	POP R1
	RTS
; ===== Code des méthodes =====
; --------------------------------------------------
; Méthodes de la classe Default
; --------------------------------------------------
; Main program
; Beginning of main declarations:
	NEW #1, R2
	BOV heap_full_isr
	LEA 1(GB), R0
	STORE R0, 0(R2)
	PUSH R2
	BSR init.Default
	SUBSP #1
	STORE R2, 1(LB)
	TSTO #1
	BOV stack_overflow_isr
	ADDSP #1
; Beginning of main instructions:
	LOAD 1(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	LOAD 0(R2), R2
	LOAD R2, R1
	WINT
	WNL
	LOAD 1(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	LOAD 0(R2), R2
	LOAD R2, R1
	WFLOAT
	WNL
	LOAD 1(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	LOAD 0(R2), R2
	CMP #0, R2
	BEQ else_0
	WSTR "erreur"
	WNL
	BRA end_if_1
else_0:
	WSTR "false"
	WNL
end_if_1:
	HALT
; --- Interrupt Service Routines (ISR) ---
heap_full_isr:
	WSTR "Erreur : Tas plein"
	WNL
	ERROR
stack_overflow_isr:
	WSTR "Erreur : Pile pleine"
	WNL
	ERROR
null_ptr_isr:
	WSTR "Erreur : Dereferencement null"
	WNL
	ERROR
; end main program
