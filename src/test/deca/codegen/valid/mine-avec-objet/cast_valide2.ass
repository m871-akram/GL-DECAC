; start main program
; Construction des tables des methodes
; --------------------------------------------------
; Classe A
; --------------------------------------------------
; Table des méthodes de A à l'adresse 1(GB)
	LOAD #0, R0
	STORE R0, 1(GB)
; --------------------------------------------------
; Classe B
; --------------------------------------------------
; Table des méthodes de B à l'adresse 2(GB)
	LEA 1(GB), R0
	STORE R0, 2(GB)
; --------------------------------------------------
; Classe C
; --------------------------------------------------
; Table des méthodes de C à l'adresse 3(GB)
	LEA 1(GB), R0
	STORE R0, 3(GB)
; ===== Sous-programmes d'initialisation =====
init.A:
; Initialisation des champs de A
	PUSH R1
	LOAD -2(LB), R1
	LOAD -2(LB), R1
	LOAD #10, R2
	STORE R2, 0(R1)
	POP R1
	RTS
init.B:
; Initialisation des champs de B
	PUSH R1
	LOAD -2(LB), R1
	PUSH R1
	BSR init.A
	SUBSP #1
	LOAD -2(LB), R1
	LOAD #20, R2
	STORE R2, 0(R1)
	POP R1
	RTS
init.C:
; Initialisation des champs de C
	PUSH R1
	LOAD -2(LB), R1
	PUSH R1
	BSR init.A
	SUBSP #1
	LOAD -2(LB), R1
	LOAD #30, R2
	STORE R2, 0(R1)
	POP R1
	RTS
; ===== Code des méthodes =====
; --------------------------------------------------
; Méthodes de la classe A
; --------------------------------------------------
; --------------------------------------------------
; Méthodes de la classe B
; --------------------------------------------------
; --------------------------------------------------
; Méthodes de la classe C
; --------------------------------------------------
; Main program
; Beginning of main declarations:
	NEW #1, R2
	BOV heap_full_isr
	LEA 2(GB), R0
	STORE R0, 0(R2)
	PEA 0(R2)
	BSR init.B
	SUBSP #1
	STORE R2, 1(LB)
	TSTO #2
	BOV stack_overflow_isr
	ADDSP #2
; Beginning of main instructions:
	LOAD 1(LB), R2
	CMP #null, R2
	BEQ cast_end_0
	LOAD 0(R2), R0
	LEA 1(GB), R1
cast_loop_1:
	CMP R1, R0
	BEQ cast_end_0
	LOAD 0(R0), R0
	CMP #null, R0
	BNE cast_loop_1
	BOV cast_error_isr
cast_end_0:
	STORE R2, 2(LB)
	LOAD 2(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	LOAD 0(R2), R2
	LOAD R2, R1
	WINT
	WNL
	HALT
; --- Interrupt Service Routines (ISR) ---
cast_error_isr:
	WSTR "Erreur : Cast invalide"
	WNL
	ERROR
null_ptr_isr:
	WSTR "Erreur : Dereferencement null"
	WNL
	ERROR
stack_overflow_isr:
	WSTR "Erreur : Pile pleine"
	WNL
	ERROR
heap_full_isr:
	WSTR "Erreur : Tas plein"
	WNL
	ERROR
; end main program
