; start main program
; Construction des tables des methodes
; --------------------------------------------------
; Classe A
; --------------------------------------------------
; Table des méthodes de A à l'adresse 1(GB)
	LOAD #0, R0
	STORE R0, 1(GB)
	LOAD code.A.hello, R0
	STORE R0, 1(GB)
; ===== Sous-programmes d'initialisation =====
init.A:
; Initialisation des champs de A
	PUSH R1
	LOAD -2(LB), R1
	POP R1
	RTS
; ===== Code des méthodes =====
; --------------------------------------------------
; Méthodes de la classe A
; --------------------------------------------------
code.A.hello:
; Méthode hello
	TSTO #0
	BOV stack_overflow_isr
	ADDSP #0
	WSTR "Hello World"
	WNL
	RTS
; Main program
; Beginning of main declarations:
	NEW #1, R2
	BOV heap_full_isr
	LEA 1(GB), R0
	STORE R0, 0(R2)
	PUSH R2
	BSR init.A
	SUBSP #1
	STORE R2, 1(LB)
	TSTO #1
	BOV stack_overflow_isr
	ADDSP #1
; Beginning of main instructions:
	LOAD 1(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	ADDSP #1
	STORE R2, 0(SP)
	LOAD 0(SP), R2
	LOAD 0(R2), R2
	LOAD 0(R2), R2
	BSR R2
	SUBSP #1
	HALT
; --- Interrupt Service Routines (ISR) ---
null_ptr_isr:
	WSTR "Erreur : Dereferencement null"
	WNL
	ERROR
heap_full_isr:
	WSTR "Erreur : Tas plein"
	WNL
	ERROR
stack_overflow_isr:
	WSTR "Erreur : Pile pleine"
	WNL
	ERROR
; end main program
