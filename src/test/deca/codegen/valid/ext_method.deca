// Description:
//    Fils appelle méthode parent (Vérification de l'héritage et des offsets)
//
// Resultats:
//    ok
//
// Historique:
//    cree le 18/01/2026
//

class A {
    void mParent() {
        println("ok");
    }
}

class B extends A {
    void m() {
        mParent(); // Appel valide par héritage
    }
}

{
    B b = new B();
    b.m();
}