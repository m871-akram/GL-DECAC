// Description:
//    test  &&, ||, !.
//
// Resultats:
//    AND OK
//    OR OK
//    NOT OK
//     OK
//
// Historique:
//    cree le 11/01/2026

{
    //  AND
    if (76 == 76 && 2 == 2) {
        println("AND OK");
    }

    //  OR (avec court circuit )
    if (1 == 1 || 1 == 0) {
        println("OR OK");
    }

    // Test NOT
    if (!(1 == 0)) {
        println("NOT OK");
    }


    if ((1 < 2 && 5 > 4) || 1 == 0) {
        println(" OK");
    }

}