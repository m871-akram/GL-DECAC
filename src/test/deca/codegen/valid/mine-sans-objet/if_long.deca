{
    int i = 5;
    if ( i == 1) { println (1);}
    else  if ( i == 2) { println (2);}
    else  if ( i == 3) { println (3);}
    else  if ( i == 4) { println (4);}
    else  if ( i == 5) { println (5);}
    else { println("autre");}


} 