// Description:
//    Programme complet : Boucle while et conditionnelle if/else avec modulo
//
// Resultats:
//    0 est pair
//    1 est impair
//    2 est pair
//    3 est impair
//    4 est pair
//    5 est impair
//    6 est pair
//
// Historique:
//    cree le 15/01/2026

{
    int i = 0;
    while (i <= 6) {
        if (i % 2 == 0) {
            println(i, " est pair");
        } else {
            println(i, " est impair");
        }
        i = i + 1;
    }
}