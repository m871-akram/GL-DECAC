; start main program
; Construction des tables des methodes
; --------------------------------------------------
; Classe Polyexp
; --------------------------------------------------
; Table des méthodes de Polyexp à l'adresse 1(GB)
	LOAD #0, R0
	STORE R0, 1(GB)
	LOAD code.Polyexp.pexp, R0
	STORE R0, 1(GB)
; ===== Sous-programmes d'initialisation =====
init.Polyexp:
; Initialisation des champs de Polyexp
	PUSH R1
	LOAD -2(LB), R1
	POP R1
	RTS
; ===== Code des méthodes =====
; --------------------------------------------------
; Méthodes de la classe Polyexp
; --------------------------------------------------
code.Polyexp.pexp:
; Méthode pexp
	TSTO #0
	BOV stack_overflow_isr
	ADDSP #0
	LOAD -3(LB), R0
	LOAD -3(LB), R2
	LOAD -3(LB), R3
	LOAD -3(LB), R4
	LOAD -3(LB), R5
	LOAD -3(LB), R6
	LOAD -3(LB), R7
	LOAD #0x1.0p0, R8
	LOAD #0x1.3bp12, R9
	DIV R9, R8
	BOV div_zero_isr
	MUL R8, R7
	LOAD #0x1.0p0, R8
	LOAD #0x1.68p9, R9
	DIV R9, R8
	BOV div_zero_isr
	ADD R8, R7
	MUL R7, R6
	LOAD #0x1.0p0, R7
	LOAD #0x1.ep6, R8
	DIV R8, R7
	BOV div_zero_isr
	ADD R7, R6
	MUL R6, R5
	LOAD #0x1.0p0, R6
	LOAD #0x1.8p4, R7
	DIV R7, R6
	BOV div_zero_isr
	ADD R6, R5
	MUL R5, R4
	LOAD #0x1.0p0, R5
	LOAD #0x1.8p2, R6
	DIV R6, R5
	BOV div_zero_isr
	ADD R5, R4
	MUL R4, R3
	LOAD #0x1.0p0, R4
	LOAD #0x1.0p1, R5
	DIV R5, R4
	BOV div_zero_isr
	ADD R4, R3
	MUL R3, R2
	LOAD #0x1.0p0, R3
	ADD R3, R2
	MUL R2, R0
	LOAD #1, R2
	FLOAT R2, R2
	SUB R2, R0
	BRA end.Polyexp.pexp
end.Polyexp.pexp:
	RTS
; Main program
; Beginning of main declarations:
	NEW #1, R2
	BOV heap_full_isr
	LEA 1(GB), R0
	STORE R0, 0(R2)
	PUSH R2
	BSR init.Polyexp
	SUBSP #1
	STORE R2, 1(LB)
	LOAD #0x0.0p0, R2
	STORE R2, 2(LB)
	LOAD #0x1.0p0, R2
	STORE R2, 3(LB)
	LOAD #0x1.0p0, R2
	OPP R2, R2
	STORE R2, 4(LB)
	LOAD #0x1.6fc2ecp-1, R2
	STORE R2, 5(LB)
	TSTO #7
	BOV stack_overflow_isr
	ADDSP #7
; Beginning of main instructions:
	BRA while_cond_2
loop_start_0:
	LOAD 1(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	ADDSP #2
	STORE R2, 0(SP)
	LOAD 2(LB), R2
	LOAD 3(LB), R3
	ADD R3, R2
	LOAD #0x1.0p1, R3
	DIV R3, R2
	BOV div_zero_isr
	STORE R2, 6(LB)
	STORE R2, -1(SP)
	LOAD 0(SP), R2
	LOAD 0(R2), R2
	LOAD 0(R2), R2
	BSR R2
	SUBSP #2
	LOAD R0, R2
	STORE R2, 7(LB)
	LOAD #0x0.0p0, R3
	CMP R3, R2
	SGT R2
	CMP #0, R2
	BEQ else_3
	LOAD 6(LB), R2
	STORE R2, 3(LB)
	LOAD 7(LB), R2
	STORE R2, 5(LB)
	BRA end_if_4
else_3:
	LOAD 6(LB), R2
	STORE R2, 2(LB)
	LOAD 7(LB), R2
	STORE R2, 4(LB)
end_if_4:
while_cond_2:
	LOAD 3(LB), R2
	LOAD 2(LB), R3
	LOAD #0x1.0p-23, R4
	ADD R4, R3
	CMP R3, R2
	SGE R2
	CMP #0, R2
	BNE loop_start_0
loop_exit_1:
	LOAD 2(LB), R1
	WFLOAT
	WSTR " = "
	LOAD 2(LB), R1
	WFLOAT
	WNL
	HALT
; --- Interrupt Service Routines (ISR) ---
null_ptr_isr:
	WSTR "Erreur : Dereferencement null"
	WNL
	ERROR
heap_full_isr:
	WSTR "Erreur : Tas plein"
	WNL
	ERROR
stack_overflow_isr:
	WSTR "Erreur : Pile pleine"
	WNL
	ERROR
div_zero_isr:
	WSTR "Erreur : Division par zero"
	WNL
	ERROR
; end main program
