; start main program
	BRA main_start
; Méthode Object.equals (comparaison référentielle)
equals:
	LOAD -2(LB), R0
	LOAD -3(LB), R1
	CMP R1, R0
	SEQ R0
	RTS
; Table des méthodes de Object
	LOAD #null, R0
	STORE R0, 1(GB)
	LOAD equals, R0
	STORE R0, 2(GB)
; Construction des tables des methodes
; init objets
init.Object:
	RTS
; Code des méthodes
main_start:
; Main program
; Beginning of main declarations:
	TSTO #11
	BOV stack_overflow_isr
	ADDSP #11
	LOAD #1, R2
	STORE R2, 1(LB)
	LOAD #2, R2
	STORE R2, 2(LB)
	LOAD #3, R2
	STORE R2, 3(LB)
	LOAD #4, R2
	STORE R2, 4(LB)
	LOAD #5, R2
	STORE R2, 5(LB)
	LOAD #6, R2
	STORE R2, 6(LB)
	LOAD #7, R2
	STORE R2, 7(LB)
	LOAD #8, R2
	STORE R2, 8(LB)
	LOAD #9, R2
	STORE R2, 9(LB)
	LOAD #10, R2
	STORE R2, 10(LB)
	LOAD 1(LB), R2
	LOAD 2(LB), R3
	ADD R3, R2
	LOAD 3(LB), R3
	ADD R3, R2
	LOAD 4(LB), R3
	ADD R3, R2
	LOAD 5(LB), R3
	ADD R3, R2
	LOAD 6(LB), R3
	ADD R3, R2
	LOAD 7(LB), R3
	ADD R3, R2
	LOAD 8(LB), R3
	ADD R3, R2
	LOAD 9(LB), R3
	ADD R3, R2
	LOAD 10(LB), R3
	ADD R3, R2
	STORE R2, 11(LB)
; Beginning of main instructions:
	WSTR "Somme = "
	LOAD 11(LB), R1
	WINT
	WNL
	HALT
; --- Interrupt Service Routines (ISR) ---
stack_overflow_isr:
	WSTR "Erreur : Pile pleine"
	WNL
	ERROR
; end main program
