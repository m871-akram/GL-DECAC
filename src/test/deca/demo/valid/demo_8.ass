; start main program
	BRA main_start
; Construction des tables des methodes
; init objets
; Code des méthodes
main_start:
; Main program
; Beginning of main declarations:
	LOAD #1, R2
	STORE R2, 1(LB)
	LOAD #0, R2
	STORE R2, 2(LB)
	LOAD #2, R2
	STORE R2, 3(LB)
	TSTO #4
	BOV stack_overflow_isr
	ADDSP #4
; Beginning of main instructions:
	WSTR "donne un nombre"
	WNL
	RINT
	BOV io_error_isr
	LOAD R1, R2
	STORE R2, 4(LB)
	WSTR "on va jouer a un jeux donne 1, 2, ou 3 pour pierre, papier, ciseaux"
	WNL
	BRA while_cond_2
loop_start_0:
	WSTR "   round :"
	LOAD 1(LB), R1
	WINT
	WNL
	WNL
	LOAD 4(LB), R2
	LOAD #251, R3
	LOAD #13, R3
	ADD R3, R2
	LOAD #65521, R3
	REM R3, R2
	BOV div_zero_isr
	STORE R2, 4(LB)
	LOAD 4(LB), R2
	LOAD #3, R3
	REM R3, R2
	BOV div_zero_isr
	LOAD #1, R3
	ADD R3, R2
	STORE R2, 3(LB)
	RINT
	BOV io_error_isr
	LOAD R1, R2
	STORE R2, 2(LB)
	LOAD 4(LB), R2
	LOAD 2(LB), R3
	ADD R3, R2
	STORE R2, 4(LB)
	LOAD 2(LB), R2
	LOAD 3(LB), R3
	CMP R3, R2
	SEQ R2
	CMP #0, R2
	BEQ else_3
	WSTR "egalité"
	WNL
	BRA end_if_4
else_3:
	LOAD 2(LB), R2
	LOAD #1, R3
	CMP R3, R2
	SEQ R2
	CMP #0, R2
	BEQ end_and_8
	LOAD 3(LB), R2
	LOAD #3, R3
	CMP R3, R2
	SEQ R2
	CMP #0, R2
	BNE end_or_7
end_and_8:
	LOAD 2(LB), R2
	LOAD #2, R3
	CMP R3, R2
	SEQ R2
	CMP #0, R2
	BEQ end_and_9
	LOAD 3(LB), R2
	LOAD #1, R3
	CMP R3, R2
	SEQ R2
	CMP #0, R2
	BNE end_or_7
end_and_9:
	LOAD 2(LB), R2
	LOAD #3, R3
	CMP R3, R2
	SEQ R2
	CMP #0, R2
	BEQ else_5
	LOAD 3(LB), R2
	LOAD #2, R3
	CMP R3, R2
	SEQ R2
	CMP #0, R2
	BEQ else_5
end_or_7:
	WSTR "victoire joueur!!!!!!"
	WNL
	BRA end_if_6
else_5:
	WSTR "dommage?"
	WNL
end_if_6:
end_if_4:
	LOAD 1(LB), R2
	LOAD #1, R3
	ADD R3, R2
	STORE R2, 1(LB)
while_cond_2:
	LOAD 1(LB), R2
	LOAD #5, R3
	CMP R3, R2
	SLE R2
	CMP #0, R2
	BNE loop_start_0
loop_exit_1:
	HALT
; --- Interrupt Service Routines (ISR) ---
stack_overflow_isr:
	WSTR "Erreur : Pile pleine"
	WNL
	ERROR
div_zero_isr:
	WSTR "Erreur : Division par zero"
	WNL
	ERROR
io_error_isr:
	WSTR "Erreur : IO"
	WNL
	ERROR
; end main program
