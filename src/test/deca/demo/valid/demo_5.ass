; start main program
	BRA main_start
; Méthode Object.equals (comparaison référentielle)
equals:
	LOAD -2(LB), R0
	LOAD -3(LB), R1
	CMP R1, R0
	SEQ R0
	RTS
; Table des méthodes de Object
	LOAD #null, R0
	STORE R0, 1(GB)
	LOAD equals, R0
	STORE R0, 2(GB)
; Construction des tables des methodes
; Classe Hello
; Table des méthodes de Hello à l'adresse 3(GB)
	LOAD #0, R0
	STORE R0, 3(GB)
	LOAD code.Hello.hello, R0
	STORE R0, 5(GB)
; init objets
init.Object:
	RTS
init.Hello:
; Initialisation des champs de Hello
	PUSH R1
	LOAD -2(LB), R1
	POP R1
	RTS
; Code des méthodes
; Méthodes de la classe Hello
code.Hello.hello:
; Méthode hello
	TSTO #0
	BOV stack_overflow_isr
	ADDSP #0
	WSTR "hello "
	RTS
	BOV missing_ret
main_start:
; Main program
; Beginning of main declarations:
	TSTO #1
	BOV stack_overflow_isr
	ADDSP #1
	NEW #1, R2
	BOV heap_full_isr
	LEA 3(GB), R0
	STORE R0, 0(R2)
	PUSH R2
	BSR init.Hello
	POP R2
	STORE R2, 1(LB)
; Beginning of main instructions:
	LOAD 1(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	ADDSP #1
	STORE R2, 0(SP)
	LOAD 0(SP), R2
	LOAD 0(R2), R2
	BSR code.Hello.hello
	SUBSP #1
	WSTR "world"
	WNL
	HALT
; --- Interrupt Service Routines (ISR) ---
stack_overflow_isr:
	WSTR "Erreur : Pile pleine"
	WNL
	ERROR
missing_ret:
	WSTR "Erreur : il manque un retour"
	WNL
	ERROR
null_ptr_isr:
	WSTR "Erreur : Dereferencement null"
	WNL
	ERROR
heap_full_isr:
	WSTR "Erreur : Tas plein"
	WNL
	ERROR
; end main program
