; start main program
	BRA main_start
; Construction des tables des methodes
; init objets
; Code des méthodes
main_start:
; Main program
; Beginning of main declarations:
	TSTO #0
	BOV stack_overflow_isr
	ADDSP #0
; Beginning of main instructions:
	LOAD #10, R2
	LOAD R2, R1
	WINT
	LOAD #0x1.91eb86p1, R2
	LOAD R2, R1
	WFLOATX
	HALT
; --- Interrupt Service Routines (ISR) ---
stack_overflow_isr:
	WSTR "Erreur : Pile pleine"
	WNL
	ERROR
; end main program
