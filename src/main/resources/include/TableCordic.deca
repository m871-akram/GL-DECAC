//sont les atan(2^-i)
//32 valeurs comme bon compromis

float cordic0 = 0.785398163f;
float cordic1 = 0.463647609f;
float cordic2 = 0.244978663f;
float cordic3 = 0.124354995f;
float cordic4 = 0.06241881f;
float cordic5 = 0.0312398334f;
float cordic6 = 0.0156237286f;
float cordic7 = 0.00781234106f;
float cordic8 = 0.00390623013f;
float cordic9 = 0.00195312252f;
float cordic10 = 0.00097656219f;
float cordic11 = 0.000488281211f;
float cordic12 = 0.00024414062f;
float cordic13 = 0.000122070312f;
float cordic14 = 6.10351562e-05f;
float cordic15 = 3.05175781e-05f;
float cordic16 = 1.52587891e-05f;
float cordic17 = 7.62939453e-06f;
float cordic18 = 3.81469727e-06f;
