float cordic20 = 9.53674316e-07f;
float cordic21 = 4.76837158e-07f;
float cordic22 = 2.38418579e-07f;
float cordic23 = 1.1920929e-07f;
float cordic24 = 5.96046448e-08f;
float cordic25 = 2.98023224e-08f;
float cordic26 = 1.49011612e-08f;
float cordic27 = 7.4505806e-09f;
float cordic28 = 3.7252903e-09f;
float cordic29 = 1.86264515e-09f;
float cordic30 = 9.31322575e-10f;
float cordic31 = 4.65661287e-10f;

float _getCordic(int i) {
    if (i == 0) return cordic0;
    else if (i == 1) return cordic1;
    else if (i == 2) return cordic2;
    else if (i == 3) return cordic3;
    else if (i == 4) return cordic4;
    else if (i == 5) return cordic5;
    else if (i == 6) return cordic6;
    else if (i == 7) return cordic7;
    else if (i == 8) return cordic8;
    else if (i == 9) return cordic9;
    else if (i == 10) return cordic10;
    else if (i == 11) return cordic11;
    else if (i == 12) return cordic12;
    else if (i == 13) return cordic13;
    else if (i == 14) return cordic14;
    else if (i == 15) return cordic15;
    else if (i == 16) return cordic16;
    else if (i == 17) return cordic17;
    else if (i == 18) return cordic18;
    else if (i == 19) return cordic19;
    else if (i == 20) return cordic20;
    else if (i == 21) return cordic21;
    else if (i == 22) return cordic22;
    else if (i == 23) return cordic23;
    else if (i == 24) return cordic24;
    else if (i == 25) return cordic25;
    else if (i == 26) return cordic26;
    else if (i == 27) return cordic27;
    else if (i == 28) return cordic28;
    else if (i == 29) return cordic29;
    else if (i == 30) return cordic30;
    else if (i == 31) return cordic31;
    else {
        float pow2i = 1.0f;
        int j = 0;
        while (j < i) {
            pow2i = pow2i * 0.5f;
            j = j + 1;
        }
        return pow2i;
    }
}
