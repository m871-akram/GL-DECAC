// Library for class Math of Deca, coded in Deca



#include "TableCordic.deca";
#include "TableSinCos.deca";



class Math {

    // constantes de base , haute precision 
    protected float PI = 3.141592653589793f;
    protected float TWO_PI = 6.283185307179586f;
    protected float PI_OVER_2 = 1.5707963267948966f;
    

    //des trucs de la table SINCOS
    protected int CACHE_SIZE = 512;
    protected float CACHE_STEP = PI_OVER_2/(CACHE_SIZE -1);

  
    // Seuils pour choix d'algorithme (bon compromis précision/energie)
    protected float TRES_PETIT = 0.001f;     // Pour approximation sin(x) ~ x
    protected float PETIT = 0.1f;              // Pour table d'interpolation
    protected float VOISIN_PI_2 = 1.472f;      // pi/2 - VOISIN_PI_2 ~ 0.1

    

    float _fma(float a, float b, float c) asm("
        LOAD 2(GB), R1    ; a
        LOAD 3(GB), R2    ; b
        LOAD 4(GB), R3    ; c

        ; Préparer pour FMA: R1 * R2 + R3
        LOAD R3, R1       ; R1 = c (pour être R1 dans FMA)
        LOAD 2(GB), R2    ; R2 = a
        FMA 3(GB), R2     ; R2 = a * b + c
        
        STORE R2, 1(GB)   ; résultat dans la pile
        RTS
    ");


    float sin(float f) {
        //des cas speciaux
        if (-isNaN(f) || _isInfinite(f)) return 0.0f/0.0f;

        if (_abs(f) > 1000) {
            //marche pas en deca ! mais aide beaucoup en java (pour une bonne precision)
            double x_d = (double)f;
            double reduced_d = x_d % (TWO_PI);
            f = (float)reduced_d;
        }

        // Gestion du signe
        boolean negative = false;
        
        if (f < 0) {
            negative = true;
            f = -f;
        }

        float x_red;
        x_red = _reduction2PIRecursive(f);

        // on reduit x_red au premier demi-cercle [0, PI]
        if (x_red > PI) {
            x_red = x_red - PI;
            negative = true;                 // Dans [PI, TWO_PI], le sinus est  négatif
        }

        // on reduit le au premier quadrant [0, PI/2]
        if (x_red > PI_OVER_2) {
            x_red = PI_OVER_2 - x_red;           // sin(PI - x) = sin(x), cad le signe ne change pas ici
        }

        // Choix de la méthode
        float result;
        if (x_red < TRES_PETIT) {
            result = x_red;                         // sin(x) = x
        } 
        else if (x_red < PETIT) {
            result = _tableSin(x_red);                            // Table d'interpolation
        }
        else if (x_red > VOISIN_PI_2) {
            float res = PI_OVER_2 - x_red;
            if(res < TRES_PETIT) {result = 1.0f;}                    //cos(res)~1
            else if (res < PETIT){result = tableCos(res);}
            else {result = 1.0f;}      //tableCos(res);}           // inversion}(res < PETIT -0.1f) 
        else {
            result = _cordicSin(x_red);   }               // Cordic
        
        // on met le signe
        return negative ? -result : result; 
    }



    

    // CORDIC pour la fonction sin
    float _cordicSin(float x) {
        boolean inverse = false;
        if (angle > PI_OVER_4) {
            angle = PI_OVER_2 - angle;
            inverse = true;
        }
        
        // on initialise l'algo Cordic
        float x = CORDIC_K_CONST;       //cette constante depend de la table cordic qu'on a pre-calcule
        float y = 0.0f;
        float z = angle;
        
        int iterations = (24 <= CORDIC_TABLE_SIZE) ? 24:CORDIC_TABLE_SIZE;      //min(24 , CORDIC_TABLE_SIZE)
        
        for (int i = 0; i < iterations; i++) {
            float xOld = x;
            float pow2i = 1.0f / (float)(1 << i); 
            if (z >= 0) {
                x = x - y * pow2i;
                y = y + xOld * pow2i;
                z = z - cordic_i;
            } else {
                x = x + y * pow2i;
                y = y - xOld * pow2i;
                z = z + cordic_i;
            }
        }
        
        if (inverse) {
            return y;             // x,y = cos(pi/2-angle), sin(pi/2-angle)
        }
        
        return x;
    }
    
    // CORDIC pour la fonction cos
    float _cordicCos(float x) {
        boolean inverse = false;
        if (angle > PI_OVER_4) {
            angle = PI_OVER_2 - angle;
            inverse = true;
        }
        
        // on initialise l'algo Cordic
        float x = CORDIC_K_CONST;       //cette constante depend de la table cordic qu'on a pre-calcule
        float y = 0.0f;
        float z = angle;
        
        int iterations = (24 <= CORDIC_TABLE_SIZE) ? 24:CORDIC_TABLE_SIZE;      //min(24 , CORDIC_TABLE_SIZE)
        
        for (int i = 0; i < iterations; i++) {
            float xOld = x;
            float pow2i = 1.0f / (float)(1 << i); 
            if (z >= 0) {
                x = x - y * pow2i;
                y = y + xOld * pow2i;
                z = z - cordic_i;
            } else {
                x = x + y * pow2i;
                y = y - xOld * pow2i;
                z = z + cordic_i;
            }
        }
        
        if (inverse) {
            return x;  
        }
        
        return y;    
    }
    


    //l'algo d'interpolation depuis la table sin
    float _tableSin(float x) {
        float index_f = x / CACHE_STEP;
        int i = (int) index_f;
        if (i >= CACHE_SIZE - 1) return _getSinValue(CACHE_SIZE - 1);

        float h = x - (i * CACHE_STEP);     // L'incrément (petit)
        
        // Approximation de Taylor pour sin(h) et cos(h) car h est minuscule
        float sin_h = h; 
        float cos_h = 1.0f - (h * h * 0.5f);

        // Formule d'addition
        return sin_i * cos_h + cos_i * sin_h;
    }


    //l'algo d'interpolation depuis la table cos
    float _tableCos(float x) {
        float index_f = x / CACHE_STEP;
        int i = (int) index_f;
        if (i >= SIN_COS_CACHE_SIZE - 1) return _getCosValue(CACHE_SIZE - 1);

        float h = x - (i * CACHE_STEP);             // L'incrément (petit)
        
        // Approximation de Taylor pour sin(h) et cos(h) car h est minuscule
        float sin_h = h; 
        float cos_h = 1.0f - (h * h * 0.5f);

        // Formule d'addition
        return cos_i * cos_h - sin_i * sin_h;   //on utilse apres le _fma()
    }



    float cos(float f) {
        if (_isNaN(f)) return 0.0f/0.0f;
        if (_isInfinite(f)) return 1.0f/0.0f;
        
        return sin(PI_OVER_2 - f);
    }
    
    






    
    float asin(float f) {
        // Gestion du codomaine (x doit être dans [-1, 1])
        if (x < -1.0f || x > 1.0f || Float.isNaN(x)) {
            return Float.NaN;   //il faut faire une exception (A FAIRE)
        }

        // on evite la division par zéro (1 - x^2 = 0)
        final float EPSILON = 1e-7f;      // bon compromis , depend des tests qu'on a fait 
        if (Math._abs(x - 1.0f) <= EPSILON) {
            return PI_OVER_2;
        }
        else if (Math._abs(x + 1.0f) <= EPSILON){
            return -PI_OVER_2;
        }
        
        else if (x > 0.9999f || x < - 0.9999f) {
            // Pour x près de 1 (mais =! 1)
            float delta = 1.0f - Math._abs(x);
            float result = (float)Math._sqrt(2.0f * delta);
            if (x > 0) {
                return PI_OVER_2 - result;
            } else {
                return result - PI_OVER_2;
            }
       }

        // sinon On utilise la formule : atan(x / sqrt(1 - x*x))
        //on a 3 methodes , on choisi une parmi les 3

        // Methode 1 : avec la racine , et apres on inverse
        float x2 = x * x;
        float denom = _sqrt(1.0f - x2);
        return atan(x / denom);

        // Methode 2 : avec la racine1 (autre implementation de la racine ), et apres on inverse
        /*float x2 = x * x;
        float denom = _sqrt1(1.0f - x2);
        return atan(x / denom);*/


        //Methode 3 : avec la racine inverse directement
        /*float x2 = x * x;
        float denom = _sqrt(1.0f - x2);*/
        
        return atan(x / denom);
    }




    
    float acos(float f) { 
        // on sait que : acos(x) + asin(x) = PI/2
        float res = asin(x);
        
        // Si asin renvoie NaN, acos doit aussi renvoyer NaN
        if (Float.isNaN(res)) {
            return Float.NaN;
        }
        
        return PI_OVER_2 - res;
    }





    float atan(float f) {
        //la fonction atan est la base pour les autres fonctions asin et acos
        // implemente via l'alogrithme CORDIC en mode  vectorielle , et aussi une gestion
        // des cas particuliers , via series de Taylors

        if (_isNaN(f)) return 0.0f/0.0f;
        
        if (_isInfinite(f)){
            if (f > 0.0f) {
                return PI_OVER_2;
            } else {
                return -PI_OVER_2;
            }
        }


        boolean negative = false;
        float x = f;
        if (x < 0.0f) {
            negative = true;
            x = -x;
        }
        

        // des petites valeurs : serie de Taylor
        if (x < 0.151f){
            val =x - (x*x*x)/3 + (x*x*x*x*x)/5 - (x*x*x*x*x*x*x)/7;  
            //on a choisit l'ordre 7 , apres une serie de tests
            if(negative){
                return -val;
            }else {return val;}  
        }

        // Réduction d'intervalle [0,1] pour la stabilite d'algo CORDIC 
        // si x > 1.0f , on utilise atan(x) = pi/2 - atan(1/x)
        
        boolean inverted = false;
        if (x > 1.0f) {
            x = 1.0f / x;
            inverted = true;
        }

        // CORDIC en mode Vectorisation 
        // ici x est dans [0.151,1] , bonne plage pour CORDIC
        // On part du vecteur (1, x) et on tourne pour ramener y vers 0

        float curr_x = 1.0f;
        float curr_y = x;
        float angle_accumulee = 0.0f;
        float pow2i = 1.0f;

        int i = 0;
        while (i < 30) {                // on a choisit 30 apres les tests (c'est un compromis entre complexite et precision)
            float x_old = curr_x;
            
            float cordici = _getCordic(i) ;     //fonction dans le fichier "TableCordic.deca"
            if (curr_y > 0) {
                curr_x = curr_x + curr_y * pow2i;
                curr_y = curr_y - x_old * pow2i;
                angle_accumulee = angle_accumulee + cordici;
            } else {
                curr_x = curr_x - curr_y * pow2i;
                curr_y = curr_y + x_old * pow2i;
                angle_accumulee = angle_accumulee - cordici;
            }
            pow2i = pow2i * 0.5f;
            i = i + 1;
        }


        float res = angle_accumulee;

        // Retransformation
        if (inverted) {
            res = PI_OVER_2 - res;
        }

        if(negative){
            return -res;
        }else {return res;} 

    }



    //la fonction ulp en deca ; pas encore teste , (en attendant le compilateur)  
    float ulp(float f) {
        //l'idee est de reconstruire l'entree manuellement

        // cas particulier 0
        if (f == 0.0) {
            return 1.40129846e-45;     // ~ 2^-149 (le plus petit nombre  dénormalisé)
        }
        
        //cas de NaN
        if(_isNaN(f)){
            return 0.0f/0.0f;      //c'est le NAN
        }

        // cas Infini
        if (_isInfinite(f)) {
            return 1.0f/0.0f;
        }


        // on travaille avec la valeur absolue (car l'ULP est toujours positif)
        float val;
      
        if (f < 0.0) {
            val = -f;
        } else {
            val = f;
        }



        //  On commence par chercher l'exposant par normalisation
        // l'idee est de chercher exp telque : 2^exp <= val < 2^(exp+1)
        int exp = 0;

        if (val >= 1.0) {
            while (val >= 2.0) {
                val = val / 2.0;
                exp = exp + 1;
            }
        } else {
            while (val < 1.0) {
                val = val * 2.0;
                exp = exp - 1;
            }
        }


        //  en suite on calcul  l'ULP : 2^(exp - 23)
        // Le décalage de 23 correspond aux bits de la mantisse en simple précision(float 32bit )
        int targetExp = exp - 23;
        
        if (targetExp < -126) {
            // dans ce cas, on est en  dessous de l'exposant minimum
            return 1.40129846e-45;   //valeur minimal 
        }

        // en fin , en reconstruit  la puissance de 2 par itérations(while)
        float res = 1.0f;
        int i;
        
        if (targetExp >= 0) {
            i = 0;
            while (i < targetExp) {
                res = res * 2.0;
                i = i + 1;
            }
        } else {
            i = 0;
            targetExp = -targetExp;
            while (i < targetExp) {
                res = res / 2.0;
                i = i + 1;
            }
        }

        return res;   //c'est notre ulp(f)
    }


    // fonction auxiliare  pour tester NaN
    boolean _isNaN(float f) {
        return f != f;
    }

    // fonction auxiliare  pour tester les INFINIs
    boolean _isInfinite(float f) {
        float INFINI = 1.0f / 0.0f;
        return f == INFINI || f == -INFINI;
    }


    float _reduction2PIRecursive(f){
        // Cas de base :
        if (x >= 0 && x < TWO_PI) {
            return x;
        }
        
        // Cas négatif
        else if (x < 0) {
            return _reduction2PIRecursive(x + TWO_PI);
        }

        // x >= 2pi, réduire avec le plus grand multiple possible
        else if (x >= 51471.85403641517f) {      // 16384pi
            return _reduction2PIRecursive(x - 51471.85403641517f);
        }
        else if (x >= 25735.927018207584f) {     // 8192pi
            return _reduction2PIRecursive(x - 25735.927018207584f);
        }
        else if (x >= 12867.963509103792f) {     // 4096pi
            return _reduction2PIRecursive(x - 12867.963509103792f);
        }
        else if (x >= 6433.981754551896f) {      // 2048pi
            return _reduction2PIRecursive(x - 6433.981754551896f);
        }
        else if (x >= 3216.990877275948f) {      // 1024pi
            return _reduction2PIRecursive(x - 3216.990877275948f);
        }
        else if (x >= 1608.495438637974f) {      // 512pi
            return _reduction2PIRecursive(x - 1608.495438637974f);
        }
        else if (x >= 804.247719318987f) {       // 256pi
            return _reduction2PIRecursive(x - 804.247719318987f);
        }
        else if (x >=402.1238596594935f ) {       // 128pi
            return _reduction2PIRecursive(x - 402.1238596594935f);
        }
        else if (x >= 201.06192982974676f) {       // 64pi
            return _reduction2PIRecursive(x - 201.06192982974676f );
        }
        else if (x >= 100.53096491487338f) {       // 32pi
            return _reduction2PIRecursive(x - 100.53096491487338f);
        }
        else if (x >= 50.26548245743669f) {       // 16pi
            return _reduction2PIRecursive(x - 50.26548245743669f);
        }
        else if (x >=25.132741228718345f) {       // 8pi
            return _reduction2PIRecursive(x - 25.132741228718345f);
        }
        else if (x >=12.566370614359172f ) {       // 4pi
            return _reduction2PIRecursive(x - 12.566370614359172f);
        
        }else{
        // Sinon, dernière réduction
        return _reduction2PIRecursive(x - TWO_PI);
        }
    }

    




