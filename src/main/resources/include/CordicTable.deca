class CordicTable {
    
    float _getPow2(int i) {
        
        if (i < 16) {
            if (i < 8) {
                if (i < 4) {
                    if (i < 2) {
                        if (i == 0) return 1.0f;
                        else return 5.000000000E-01f; // i == 1
                    } else {
                        if (i == 2) return 2.500000000E-01f;
                        else return 1.250000000E-01f; // i == 3
                    }
                } else {
                    if (i < 6) {
                        if (i == 4) return 6.250000000E-02f;
                        else return 3.125000000E-02f; // i == 5
                    } else {
                        if (i == 6) return 1.562500000E-02f;
                        else return 7.812500000E-03f; // i == 7
                    }
                }
            } else {
                if (i < 12) {
                    if (i < 10) {
                        if (i == 8) return 3.906250000E-03f;
                        else return 1.953125000E-03f; // i == 9
                    } else {
                        if (i == 10) return 9.765625000E-04f;
                        else return 4.882812500E-04f; // i == 11
                    }
                } else {
                    if (i < 14) {
                        if (i == 12) return 2.441406250E-04f;
                        else return 1.220703125E-04f; // i == 13
                    } else {
                        if (i == 14) return 6.103515625E-05f;
                        else return 3.051757812E-05f; // i == 15
                    }
                }
            }
        } else {
            if (i < 24) {
                if (i < 20) {
                    if (i < 18) {
                        if (i == 16) return 1.525878906E-05f;
                        else return 7.629394531E-06f; // i == 17
                    } else {
                        if (i == 18) return 3.814697266E-06f;
                        else return 1.907348633E-06f; // i == 19
                    }
                } else {
                    if (i < 22) {
                        if (i == 20) return 9.536743164E-07f;
                        else return 4.768371582E-07f; // i == 21
                    } else {
                        if (i == 22) return 2.384185791E-07f;
                        else return 1.192092896E-07f; // i == 23
                    }
                }
            } else {
                if (i < 28) {
                    if (i < 26) {
                        if (i == 24) return 5.960464478E-08f;
                        else return 2.980232239E-08f; // i == 25
                    } else {
                        if (i == 26) return 1.490116119E-08f;
                        else return 7.450580597E-09f; // i == 27
                    }
                } else {
                    if (i < 30) {
                        if (i == 28) return 3.725290298E-09f;
                        else return 1.862645149E-09f; // i == 29
                    } else {
                        return 9.313225746E-10f; // i == 30
                    }
                }
            }
        }
    }
    
    float _getCordic(int i) {
        if (i < 0 || i > 30) return 0.0f;
        
        if (i < 16) {
            if (i < 8) {
                if (i < 4) {
                    if (i < 2) {
                        if (i == 0) return 7.853981634E-01f;
                        else return 4.636476090E-01f; // i == 1
                    } else {
                        if (i == 2) return 2.449786631E-01f;
                        else return 1.243549945E-01f; // i == 3
                    }
                } else {
                    if (i < 6) {
                        if (i == 4) return 6.241881000E-02f;
                        else return 3.123983343E-02f; // i == 5
                    } else {
                        if (i == 6) return 1.562372862E-02f;
                        else return 7.812341060E-03f; // i == 7
                    }
                }
            } else {
                if (i < 12) {
                    if (i < 10) {
                        if (i == 8) return 3.906230132E-03f;
                        else return 1.953122516E-03f; // i == 9
                    } else {
                        if (i == 10) return 9.765621896E-04f;
                        else return 4.882812112E-04f; // i == 11
                    }
                } else {
                    if (i < 14) {
                        if (i == 12) return 2.441406201E-04f;
                        else return 1.220703119E-04f; // i == 13
                    } else {
                        if (i == 14) return 6.103515617E-05f;
                        else return 3.051757812E-05f; // i == 15
                    }
                }
            }
        } else {
            if (i < 24) {
                if (i < 20) {
                    if (i < 18) {
                        if (i == 16) return 1.525878906E-05f;
                        else return 7.629394531E-06f; // i == 17
                    } else {
                        if (i == 18) return 3.814697266E-06f;
                        else return 1.907348633E-06f; // i == 19
                    }
                } else {
                    if (i < 22) {
                        if (i == 20) return 9.536743164E-07f;
                        else return 4.768371582E-07f; // i == 21
                    } else {
                        if (i == 22) return 2.384185791E-07f;
                        else return 1.192092896E-07f; // i == 23
                    }
                }
            } else {
                if (i < 28) {
                    if (i < 26) {
                        if (i == 24) return 5.960464478E-08f;
                        else return 2.980232239E-08f; // i == 25
                    } else {
                        if (i == 26) return 1.490116119E-08f;
                        else return 7.450580597E-09f; // i == 27
                    }
                } else {
                    if (i < 30) {
                        if (i == 28) return 3.725290298E-09f;
                        else return 1.862645149E-09f; // i == 29
                    } else {
                        return 9.313225746E-10f; // i == 30
                    }
                }
            }
        }
    }
}