; start main program
	BRA vtable_init
; Méthode Object.equals (comparaison référentielle)
equals:
	LOAD -2(LB), R0
	LOAD -3(LB), R1
	CMP R1, R0
	SEQ R0
	RTS
vtable_init:
; Initialisation des tables de méthodes
	ADDSP #17
; Table des méthodes de Object
	LOAD #null, R0
	STORE R0, 1(GB)
	LOAD equals, R0
	STORE R0, 2(GB)
; Construction des tables des methodes
; Classe A
; Table des méthodes de A à l'adresse 3(GB)
	LEA 1(GB), R0
	STORE R0, 3(GB)
	LOAD 2(GB), R0
	STORE R0, 4(GB)
	LOAD code.A.setX, R0
	STORE R0, 5(GB)
	LOAD code.A.getX, R0
	STORE R0, 6(GB)
	LOAD code.A.description, R0
	STORE R0, 7(GB)
	LOAD code.A.calcul, R0
	STORE R0, 8(GB)
; Classe B
; Table des méthodes de B à l'adresse 9(GB)
	LEA 3(GB), R0
	STORE R0, 9(GB)
	LOAD 4(GB), R0
	STORE R0, 10(GB)
	LOAD 5(GB), R0
	STORE R0, 11(GB)
	LOAD 6(GB), R0
	STORE R0, 12(GB)
	LOAD 7(GB), R0
	STORE R0, 13(GB)
	LOAD 8(GB), R0
	STORE R0, 14(GB)
	LOAD code.B.setY, R0
	STORE R0, 15(GB)
	LOAD code.B.description, R0
	STORE R0, 13(GB)
	LOAD code.B.division, R0
	STORE R0, 16(GB)
	LOAD code.B.fact, R0
	STORE R0, 17(GB)
	BRA main_start
; init objets
init.Object:
	RTS
init.A:
; Initialisation des champs de A
	PUSH R1
	LOAD -2(LB), R1
	LOAD #0, R0
	STORE R0, 1(R1)
	POP R1
	RTS
init.B:
; Initialisation des champs de B
	PUSH R1
	LOAD -2(LB), R1
	PUSH R1
	BSR init.A
	SUBSP #1
	LOAD #0x0.0p0, R0
	STORE R0, 2(R1)
	POP R1
	RTS
; Code des méthodes
; Méthodes de la classe A
code.A.setX:
; Méthode setX
	TSTO #0
	BOV stack_overflow_isr
	ADDSP #0
	LOAD -3(LB), R2
	LOAD -2(LB), R3
	CMP #null, R3
	BOV null_ptr_isr
	STORE R2, 1(R3)
	RTS
	BOV missing_ret
code.A.getX:
; Méthode getX
	TSTO #0
	BOV stack_overflow_isr
	ADDSP #0
	LOAD -2(LB), R0
	CMP #null, R0
	BOV null_ptr_isr
	LOAD 1(R0), R0
	RTS
	BOV missing_ret
code.A.description:
; Méthode description
	TSTO #0
	BOV stack_overflow_isr
	ADDSP #0
	WSTR "Je suis la classe A (Base). x = "
	LOAD -2(LB), R1
	LOAD 1(R1), R1
	WINT
	WNL
	RTS
	BOV missing_ret
code.A.calcul:
; Méthode calcul
	TSTO #0
	BOV stack_overflow_isr
	ADDSP #0
	LOAD -3(LB), R0
	LOAD -4(LB), R2
	ADD R2, R0
	RTS
	BOV missing_ret
; Méthodes de la classe B
code.B.setY:
; Méthode setY
	TSTO #0
	BOV stack_overflow_isr
	ADDSP #0
	LOAD -3(LB), R2
	LOAD -2(LB), R3
	CMP #null, R3
	BOV null_ptr_isr
	STORE R2, 2(R3)
	RTS
	BOV missing_ret
code.B.description:
; Méthode description
	TSTO #0
	BOV stack_overflow_isr
	ADDSP #0
	WSTR "Je suis la classe B (Derivee). x="
	LOAD -2(LB), R1
	LOAD 1(R1), R1
	WINT
	WSTR ", y="
	LOAD -2(LB), R1
	LOAD 2(R1), R1
	WFLOAT
	WNL
	RTS
	BOV missing_ret
code.B.division:
; Méthode division
	TSTO #0
	BOV stack_overflow_isr
	ADDSP #0
	LOAD -4(LB), R2
	LOAD #0x0.0p0, R3
	CMP R3, R2
	SEQ R2
	CMP #0, R2
	BEQ else_0
	WSTR "Erreur: division par zero"
	WNL
	LOAD #0x0.0p0, R0
	RTS
	BRA end_if_1
else_0:
	LOAD -3(LB), R0
	LOAD -4(LB), R2
	DIV R2, R0
	BOV div_zero_isr
	RTS
end_if_1:
	BOV missing_ret
code.B.fact:
; Méthode fact
	TSTO #3
	BOV stack_overflow_isr
	ADDSP #0
	LOAD -3(LB), R2
	LOAD #1, R3
	CMP R3, R2
	SLE R2
	CMP #0, R2
	BEQ else_2
	LOAD #1, R0
	RTS
	BRA end_if_3
else_2:
	LOAD -3(LB), R0
	PUSH R0
	LOAD -2(LB), R0
	CMP #null, R0
	BOV null_ptr_isr
	ADDSP #2
	STORE R0, 0(SP)
	LOAD -3(LB), R0
	LOAD #1, R2
	SUB R2, R0
	STORE R0, -1(SP)
	LOAD 0(SP), R1
	CMP #null, R1
	BOV null_ptr_isr
	LOAD 0(R1), R1
	LOAD 8(R1), R1
	BSR R1
	SUBSP #2
	LOAD R0, R0
	LOAD R0, R1
	POP R0
	MUL R1, R0
	RTS
end_if_3:
	BOV missing_ret
main_start:
; Main program
; Beginning of main declarations:
	TSTO #6
	BOV stack_overflow_isr
	ADDSP #6
	LOAD #0, R2
	STORE R2, 21(LB)
	LOAD #1, R2
	STORE R2, 23(LB)
; Beginning of main instructions:
	WSTR "=== DEBUT DU TEST ULTIME ==="
	WNL
	WSTR "--- Etape 1 : Objets simples ---"
	WNL
	NEW #3, R2
	BOV heap_full_isr
	LEA 9(GB), R0
	STORE R0, 0(R2)
	PUSH R2
	BSR init.B
	POP R2
	STORE R2, 19(LB)
	LOAD 19(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	ADDSP #2
	STORE R2, 0(SP)
	LOAD #10, R2
	STORE R2, -1(SP)
	LOAD 0(SP), R1
	CMP #null, R1
	BOV null_ptr_isr
	LOAD 0(R1), R1
	LOAD 2(R1), R1
	BSR R1
	SUBSP #2
	LOAD 19(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	ADDSP #2
	STORE R2, 0(SP)
	LOAD #0x1.cp1, R2
	STORE R2, -1(SP)
	LOAD 0(SP), R1
	CMP #null, R1
	BOV null_ptr_isr
	LOAD 0(R1), R1
	LOAD 6(R1), R1
	BSR R1
	SUBSP #2
	LOAD 19(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	ADDSP #1
	STORE R2, 0(SP)
	LOAD 0(SP), R1
	CMP #null, R1
	BOV null_ptr_isr
	LOAD 0(R1), R1
	LOAD 4(R1), R1
	BSR R1
	SUBSP #1
	WSTR "--- Etape 2 : Polymorphisme ---"
	WNL
	NEW #3, R2
	BOV heap_full_isr
	LEA 9(GB), R0
	STORE R0, 0(R2)
	PUSH R2
	BSR init.B
	POP R2
	STORE R2, 20(LB)
	LOAD 20(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	ADDSP #2
	STORE R2, 0(SP)
	LOAD #42, R2
	STORE R2, -1(SP)
	LOAD 0(SP), R1
	CMP #null, R1
	BOV null_ptr_isr
	LOAD 0(R1), R1
	LOAD 2(R1), R1
	BSR R1
	SUBSP #2
	LOAD 20(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	ADDSP #1
	STORE R2, 0(SP)
	LOAD 0(SP), R1
	CMP #null, R1
	BOV null_ptr_isr
	LOAD 0(R1), R1
	LOAD 4(R1), R1
	BSR R1
	SUBSP #1
	WSTR "--- Etape 3 : Calculs ---"
	WNL
	WSTR "Somme (10 + 5) = "
	LOAD 19(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	ADDSP #3
	STORE R2, 0(SP)
	LOAD #10, R2
	STORE R2, -1(SP)
	LOAD #5, R2
	STORE R2, -2(SP)
	LOAD 0(SP), R1
	CMP #null, R1
	BOV null_ptr_isr
	LOAD 0(R1), R1
	LOAD 5(R1), R1
	BSR R1
	SUBSP #3
	LOAD R0, R2
	LOAD R2, R1
	WINT
	WNL
	LOAD 19(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	ADDSP #3
	STORE R2, 0(SP)
	LOAD #0x1.4p3, R2
	STORE R2, -1(SP)
	LOAD #0x1.0p1, R2
	STORE R2, -2(SP)
	LOAD 0(SP), R1
	CMP #null, R1
	BOV null_ptr_isr
	LOAD 0(R1), R1
	LOAD 7(R1), R1
	BSR R1
	SUBSP #3
	LOAD R0, R2
	STORE R2, 22(LB)
	WSTR "Division (10.0 / 2.0) = "
	LOAD 22(LB), R1
	WFLOAT
	WNL
	WSTR "--- Etape 4 : Recursivite (Fact 5) ---"
	WNL
	WSTR "Factorielle de 5 = "
	LOAD 19(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	ADDSP #2
	STORE R2, 0(SP)
	LOAD #5, R2
	STORE R2, -1(SP)
	LOAD 0(SP), R1
	CMP #null, R1
	BOV null_ptr_isr
	LOAD 0(R1), R1
	LOAD 8(R1), R1
	BSR R1
	SUBSP #2
	LOAD R0, R2
	LOAD R2, R1
	WINT
	WNL
	WSTR "--- Etape 5 : Instanceof & Cast ---"
	WNL
	LOAD 20(LB), R2
	CMP #null, R2
	BEQ instanceof_end_6
	LOAD 0(R2), R0
	LEA 9(GB), R1
instanceof_loop_7:
	CMP R1, R0
	BEQ instanceof_true_8
	LOAD 0(R0), R0
	CMP #null, R0
	BNE instanceof_loop_7
	LOAD #0, R2
	BRA instanceof_end_6
instanceof_true_8:
	LOAD #1, R2
instanceof_end_6:
	CMP #0, R2
	BEQ else_4
	WSTR "Succes : poly est bien une instance de B"
	WNL
	LOAD 20(LB), R2
	CMP #null, R2
	BEQ cast_end_9
	LOAD 0(R2), R0
	LEA 9(GB), R1
cast_loop_10:
	CMP R1, R0
	BEQ cast_end_9
	LOAD 0(R0), R0
	CMP #null, R0
	BNE cast_loop_10
	BRA cast_error_isr
cast_end_9:
	STORE R2, 19(LB)
	WSTR "Cast reussi, valeur de y (defaut 0.0) = "
	LOAD 19(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	LOAD 2(R2), R2
	LOAD R2, R1
	WFLOAT
	WNL
	BRA end_if_5
else_4:
	WSTR "Echec : instanceof ne fonctionne pas"
	WNL
end_if_5:
	WSTR "--- Etape 6 : Boucle While ---"
	WNL
	LOAD #0, R2
	STORE R2, 21(LB)
	BRA while_cond_13
loop_start_11:
	LOAD 21(LB), R2
	LOAD #2, R3
	REM R3, R2
	BOV div_zero_isr
	LOAD #0, R3
	CMP R3, R2
	SEQ R2
	CMP #0, R2
	BEQ else_14
	LOAD 23(LB), R2
	CMP #0, R2
	BEQ else_14
	LOAD 21(LB), R1
	WINT
	WSTR " est pair. "
	BRA end_if_15
else_14:
	LOAD 21(LB), R1
	WINT
	WSTR " est impair. "
end_if_15:
	LOAD 21(LB), R2
	LOAD #1, R3
	ADD R3, R2
	STORE R2, 21(LB)
while_cond_13:
	LOAD 21(LB), R2
	LOAD #5, R3
	CMP R3, R2
	SLT R2
	CMP #0, R2
	BNE loop_start_11
loop_exit_12:
	WSTR ""
	WNL
	WSTR "=== FIN DU TEST ==="
	WNL
	HALT
; --- Interrupt Service Routines (ISR) ---
stack_overflow_isr:
	WSTR "Erreur : Pile pleine"
	WNL
	ERROR
missing_ret:
	WSTR "Erreur : il manque un retour"
	WNL
	ERROR
heap_full_isr:
	WSTR "Erreur : Tas plein"
	WNL
	ERROR
cast_error_isr:
	WSTR "Erreur : Cast invalide"
	WNL
	ERROR
div_zero_isr:
	WSTR "Erreur : Division par zero"
	WNL
	ERROR
null_ptr_isr:
	WSTR "Erreur : Dereferencement null"
	WNL
	ERROR
; end main program
