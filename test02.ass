; start main program
	BRA main_start
; Méthode Object.equals (comparaison référentielle)
equals:
	LOAD -2(LB), R0
	LOAD -3(LB), R1
	CMP R1, R0
	SEQ R0
	RTS
; Table des méthodes de Object
	LOAD #null, R0
	STORE R0, 1(GB)
	LOAD equals, R0
	STORE R0, 2(GB)
; Construction des tables des methodes
; Classe A
; Table des méthodes de A à l'adresse 3(GB)
	LOAD #0, R0
	STORE R0, 3(GB)
	LOAD code.A.val, R0
	STORE R0, 5(GB)
; init objets
init.Object:
	RTS
init.A:
; Initialisation des champs de A
	PUSH R1
	LOAD -2(LB), R1
	LOAD #0, R0
	STORE R0, 1(R1)
	LOAD #0, R0
	STORE R0, 2(R1)
	POP R1
	RTS
; Code des méthodes
; Méthodes de la classe A
code.A.val:
; Méthode val
	TSTO #0
	BOV stack_overflow_isr
	ADDSP #0
	LOAD -2(LB), R0
	LOAD 1(R0), R0
	LOAD -2(LB), R2
	LOAD 2(R2), R2
	ADD R2, R0
	RTS
	BOV missing_ret
main_start:
; Main program
; Beginning of main declarations:
	TSTO #1
	BOV stack_overflow_isr
	ADDSP #1
; Beginning of main instructions:
	NEW #3, R2
	BOV heap_full_isr
	LEA 3(GB), R0
	STORE R0, 0(R2)
	PUSH R2
	BSR init.A
	POP R2
	STORE R2, 1(LB)
	LOAD #1, R2
	LOAD 1(LB), R3
	CMP #null, R3
	BOV null_ptr_isr
	STORE R2, 2(R3)
	WSTR "p1.val() = "
	LOAD 1(LB), R2
	CMP #null, R2
	BOV null_ptr_isr
	ADDSP #1
	STORE R2, 0(SP)
	LOAD 0(SP), R2
	LOAD 0(R2), R2
	BSR code.A.val
	SUBSP #1
	LOAD R0, R2
	LOAD R2, R1
	WINT
	WNL
	HALT
; --- Interrupt Service Routines (ISR) ---
missing_ret:
	WSTR "Erreur : il manque un retour"
	WNL
	ERROR
heap_full_isr:
	WSTR "Erreur : Tas plein"
	WNL
	ERROR
stack_overflow_isr:
	WSTR "Erreur : Pile pleine"
	WNL
	ERROR
null_ptr_isr:
	WSTR "Erreur : Dereferencement null"
	WNL
	ERROR
; end main program
